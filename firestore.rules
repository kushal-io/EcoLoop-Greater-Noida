rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCollectorForPartner(partnerId) {
      return isAuthenticated() &&
             getUserData().role == 'collector' &&
             getUserData().partner_id == partnerId;
    }

    // 1. Users collection: users can read/write only their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 2. Partners collection: anyone can read partners list for locator
    match /partners/{partnerId} {
      allow read: if true;
      allow write: if false; // Managed via seed script/admin console
    }

    // 3. Waste categories: publicly readable rates and hazard weights
    match /waste_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Transactions collection
    match /transactions/{transactionId} {
      // User can read their own transactions, or collector for the relevant partner
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        isCollectorForPartner(resource.data.partner_id)
      );

      // User creates a pending transaction
      allow create: if isAuthenticated() &&
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.status == 'pending';

      // Only collectors for that partner can confirm the transaction
      allow update: if isAuthenticated() &&
                    isCollectorForPartner(resource.data.partner_id) &&
                    resource.data.status == 'pending' &&
                    request.resource.data.status == 'confirmed';

      allow delete: if false;
    }

    // 5. Rewards catalog: readable by all authenticated users
    match /rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // 6. Redemptions: users can read and create their own redemptions
    match /redemptions/{redemptionId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
